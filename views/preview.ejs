<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <% 
    const techStack = preview.techStack || [];
    const features = preview.features || [];
    const folders = preview.folders || [];
    const stats = preview.stats || [];
    const summary = preview.summary || {};
    const tree = preview.tree || { name: preview.safeName, type: "folder", children: [] };
    const escapeHtml = (value) => String(value)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");

    const renderTreeNode = (node, isRoot = false) => {
      const children = Array.isArray(node.children) ? node.children : [];
      const hasChildren = children.length > 0;

      return `
        <li class="tree-node ${isRoot ? "is-root" : ""} ${node.type === "folder" ? "is-folder" : "is-file"}">
          <div class="tree-row">
            <span class="tree-icon ${node.type === "folder" ? "folder" : "file"}" aria-hidden="true"></span>
            <span class="tree-name">${escapeHtml(node.name)}</span>
          </div>
          ${hasChildren ? `<ul class="tree-children">${children.map((child) => renderTreeNode(child)).join("")}</ul>` : ""}
        </li>
      `;
    };
  %>
  <main class="app-shell">
    <section class="preview-layout">
      <header class="preview-topbar">
        <span class="preview-brand">BoilerBase</span>
        <span class="status-pill">Preview</span>
      </header>

      <section class="panel preview-hero">
        <div>
          <span class="eyebrow">Project Preview</span>
          <h1><%= preview.projectName %></h1>
          <p>Review the generated scaffold before downloading the ZIP.</p>
        </div>
        <div class="preview-actions">
          <a class="button button-secondary" href="/">Back</a>
          <a class="button button-primary" href="/download/<%= previewId %>">Download Project</a>
        </div>
      </section>

      <section class="preview-grid">
        <article class="panel card">
          <div class="section-head">
            <span class="section-kicker">Summary</span>
            <h2>Project snapshot</h2>
          </div>

          <div class="summary-list">
            <div>
              <span>Project name</span>
              <strong><%= preview.projectName %></strong>
            </div>
            <div>
              <span>Stack</span>
              <strong><%= techStack.join(" · ") %></strong>
            </div>
            <div>
              <span>Output</span>
              <strong>ZIP archive</strong>
            </div>
          </div>

          <div class="stats-grid">
            <% stats.forEach(function(stat) { %>
              <div class="stat-card">
                <span><%= stat.label %></span>
                <strong><%= stat.value %></strong>
              </div>
            <% }) %>
          </div>
        </article>

        <article class="panel card tree-panel">
          <div class="section-head">
            <span class="section-kicker">Structure</span>
            <h2>Repository Tree</h2>
          </div>

          <div class="tree-card">
            <div class="tree-card-head">
              <span class="tree-card-title"><%= preview.safeName %></span>
              <span class="tree-card-meta"><%= folders.length %> paths</span>
            </div>
            <div class="tree-explorer" aria-label="Project folder structure">
              <ul class="tree-root">
                <%- renderTreeNode(tree, true) %>
              </ul>
            </div>
          </div>

          <div class="badge-row">
            <% techStack.forEach(function(item) { %>
              <span class="badge"><%= item %></span>
            <% }) %>
          </div>
        </article>

        <article class="panel card card-wide">
          <div class="section-head">
            <span class="section-kicker">Included</span>
            <h2>Feature badges</h2>
          </div>

          <div class="badge-row">
            <% features.forEach(function(feature) { %>
              <span class="badge badge-soft"><%= feature %></span>
            <% }) %>
          </div>
        </article>

        <article class="panel card card-wide">
          <div class="section-head">
            <span class="section-kicker">Notes</span>
            <h2>Small summary</h2>
          </div>

          <div class="mini-summary">
            <div>
              <span>Database</span>
              <strong><%= summary.database || "None" %></strong>
            </div>
            <div>
              <span>Auth</span>
              <strong><%= summary.auth || "None" %></strong>
            </div>
            <div>
              <span>Template</span>
              <strong><%= summary.template || "HTML" %></strong>
            </div>
            <div>
              <span>CSS</span>
              <strong><%= summary.css || "Vanilla CSS" %></strong>
            </div>
          </div>
        </article>
      </section>
    </section>
  </main>
</body>
</html>
